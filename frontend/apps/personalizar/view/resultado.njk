{% extends "templates/layout.njk" %}
{% block style %}<link rel="stylesheet" href="/static/css/resultado.css">{% endblock %}

{% block content %}
<main class="main-content">
    <header class="result-header">
        <h1 class="gold-title">Análise de Party Concluída</h1>
    </header>

    <div class="results-grid">
        <article class="build-card extended">
            <div class="card-header-main" style="text-align: center; margin-bottom: 25px;">
                <h3 class="gold-text">Gloomstalker Assassin</h3>
                <span class="class-tag">Nível 12 | Patrulheiro / Ladino</span>
            </div>

            <div class="inventory-main-grid">
                <div class="equipment-column">
                    <div class="item-slot" data-name="Elmo"><img src="/static/img/items/head.png"></div>
                    <div class="item-slot" data-name="Capa"><img src="/static/img/items/cloak.png"></div>
                    <div class="item-slot" data-name="Peitoral"><img src="/static/img/items/chest.png"></div>
                    <div class="item-slot" data-name="Luvas"><img src="/static/img/items/gloves.png"></div>
                    <div class="item-slot" data-name="Botas"><img src="/static/img/items/boots.png"></div>
                    
                    <div class="stats-block">
                        <div class="ac-highlight">AC 21</div> <div class="stat-row"><span>STR</span><strong>8</strong></div>
                        <div class="stat-row"><span>DEX</span><strong>20</strong></div>
                        <div class="stat-row"><span>CON</span><strong>14</strong></div>
                        <div class="stat-row"><span>INT</span><strong>8</strong></div>
                        <div class="stat-row"><span>WIS</span><strong>16</strong></div>
                        <div class="stat-row"><span>CHA</span><strong>10</strong></div>
                    </div>
                </div>

                <div class="center-display">
                    <div class="image-frame">
                        <img src="/static/img/teste.jpg" alt="Seu Personagem">
                    </div>
                </div>

                <div class="equipment-column">
                    <div class="item-slot" data-name="Amuleto"><img src="/static/img/items/amulet.png"></div>
                    <div class="item-slot" data-name="Anel 1"><img src="/static/img/items/ring1.png"></div>
                    <div class="item-slot" data-name="Anel 2"><img src="/static/img/items/ring2.png"></div>
                </div>
            </div>

            <div class="bottom-section">
                <div class="weapons-area">
                    <div style="text-align: center;">
                        <span style="font-size: 0.7rem; color: #888; display: block; margin-bottom: 5px;">MELEE</span>
                        <div style="display: flex; gap: 10px;">
                            <div class="item-slot" data-name="Mão Principal"><img src="/static/img/items/dagger1.png"></div>
                            <div class="item-slot" data-name="Mão Secundária"><img src="/static/img/items/dagger2.png"></div>
                        </div>
                    </div>
                    <div style="text-align: center;">
                        <span style="font-size: 0.7rem; color: #888; display: block; margin-bottom: 5px;">RANGED</span>
                        <div style="display: flex; gap: 10px;">
                            <div class="item-slot" data-name="Arco"><img src="/static/img/items/bow.png"></div>
                            <div class="item-slot" data-name="Flecha"><img src="/static/img/items/arrows.png"></div>
                        </div>
                    </div>
                </div>

                <div class="consumables-area">
                    <span class="consumable-label">Consumíveis Recomendados:</span>
                    <div style="display: flex; gap: 10px;">
                        <div class="item-slot" data-name="Poção"><img src="/static/img/items/pot1.png"></div>
                        <div class="item-slot" data-name="Elixir"><img src="/static/img/items/pot2.png"></div>
                    </div>
                </div>
            </div>

            <div class="build-footer" style="margin-top: 25px;">
                <p class="build-summary" style="text-align: center; font-style: italic; color: #aaa; border-left: 3px solid #c19a6b; padding-left: 15px;">
                    "Esta build foca em maximizar o dano de surpresa no primeiro turno de combate. 
                    Utilize a furtividade para garantir críticos automáticos."
                </p>
            </div>
        </article>

