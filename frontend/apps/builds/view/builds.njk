{% extends "templates/layout.njk" %}

{% block style %}
    <link rel="stylesheet" href="/static/css/builds.css">
{% endblock %}

{% block content %}
<main class="main-content">
    <header class="page-header">
        <h1 class="gold-title">Biblioteca de Builds</h1>
        <p class="subtitle">Explore combinações testadas pela comunidade e otimizadas por algoritmos.</p>
    </header>

    {# Barra de Filtros #}
    <section class="filter-bar">
        <div class="filter-group">
            <input type="text" placeholder="Buscar por nome..." class="bg3-input" id="searchName">
        </div>
        <div class="filter-group">
            <select class="bg3-select" id="filterClass">
                <option value="">Todas as Classes</option>
                <option value="barbaro">Bárbaro</option>
                <option value="clerigo">Clérigo</option>
                <option value="guerreiro">Guerreiro</option>
                <option value="ladino">Ladino</option>
                <option value="mago">Mago</option>
                <option value="patrulheiro">Patrulheiro</option>
            </select>
        </div>
        <div class="filter-group">
            <select class="bg3-select" id="filterAct">
                <option value="">Todos os Atos</option>
                <option value="1">Ato I</option>
                <option value="2">Ato II</option>
                <option value="3">Ato III</option>
            </select>
        </div>
        <button class="btn-filter" id="btnFiltrar">Filtrar</button>
    </section>

    {# O container vazio onde o JavaScript vai injetar os cards #}
    <div class="builds-grid" id="builds-container">
        <!-- Os cards serão gerados dinamicamente aqui -->
    </div>
</main>

<script>
    // 1. Recebe os dados do banco através do Nunjucks
    const buildsDoBanco = {{ data | dump | safe }};

    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById('builds-container');

        // 2. Checa se o banco de dados retornou vazio
        if (!buildsDoBanco || buildsDoBanco.length === 0) {
            container.innerHTML = `
                <div class="no-data" style="grid-column: 1 / -1; text-align: center; color: #c19a6b; padding: 100px;">
                    <h2>Nenhuma build encontrada no sistema.</h2>
                </div>
            `;
            return;
        }

        // 3. Função que desenha as builds na tela (Pode ser reutilizada para os Filtros depois!)
        function renderizarBuilds(listaDeBuilds) {
            container.innerHTML = ''; // Limpa a tela

            listaDeBuilds.forEach(build => {
                // O Dicionário Inteligente que substitui os 15 'elifs' do Nunjucks
                const slots = {
                    head: {}, cloak: {}, chest: {}, gloves: {}, boots: {}, amulet: {},
                    ring1: {}, ring2: {}, melee_main: {}, melee_off: {},
                    ranged_main: {}, ranged_off: {}, pot1: {}, pot2: {}, pot3: {}
                };

                // Encaixa os itens nas gavetas corretas
                build.lista_itens?.forEach(item => {
                    if (slots[item.slot]) {
                        slots[item.slot] = item;
                    }
                });

                // Template Literal do Card
                const cardHtml = `
                <article class="build-card extended">
                    <div class="card-header-main">
                        <h3 class="gold-text">${build.nome}</h3>
                        <div class="recommendation-badge">Ato ${build.ato} Recomendado</div>
                        <span class="class-tag">${build.classes}</span>
                    </div>

                    <div class="build-grid-container">
                        <div class="stats-side">
                            <div class="stats-list">
                                <div class="stat-item"><span>STR</span> <strong>${build.str}</strong></div>
                                <div class="stat-item"><span>DEX</span> <strong>${build.dex}</strong></div>
                                <div class="stat-item"><span>CON</span> <strong>${build.con}</strong></div>
                                <div class="stat-item"><span>INT</span> <strong>${build.int_stat}</strong></div>
                                <div class="stat-item"><span>WIS</span> <strong>${build.wis}</strong></div>
                                <div class="stat-item"><span>CHA</span> <strong>${build.cha}</strong></div>
                            </div>
                            <div class="ac-display">
                                <span class="ac-label">AC</span>
                                <span class="ac-value">${build.ac}</span>
                            </div>
                        </div>

                        <div class="center-preview">
                            <div class="image-frame">
                                <img src="${build.img_portrait}" alt="${build.nome}">
                            </div>
                        </div>

                        <div class="gear-side">
                            <div class="gear-row">
                                ${renderSlot(slots.head)}
                                ${renderSlot(slots.cloak)}
                            </div>
                            <div class="gear-row">
                                ${renderSlot(slots.chest)}
                                ${renderSlot(slots.amulet)}
                            </div>
                            <div class="gear-row">
                                ${renderSlot(slots.gloves)}
                                ${renderSlot(slots.ring1)}
                            </div>
                            <div class="gear-row">
                                ${renderSlot(slots.boots)}
                                ${renderSlot(slots.ring2)}
                            </div>
                        </div>
                    </div>

                    <div class="weapons-section">
                        <div class="weapon-group">
                            <span class="label">Melee</span>
                            <div class="slot-row">
                                ${renderSlot(slots.melee_main, 'weapon-size')}
                                ${renderSlot(slots.melee_off, 'weapon-size')}
                            </div>
                        </div>
                        <div class="weapon-group">
                            <span class="label">Ranged</span>
                            <div class="slot-row">
                                ${renderSlot(slots.ranged_main, 'weapon-size')}
                                ${renderSlot(slots.ranged_off, 'weapon-size')}
                            </div>
                        </div>
                    </div>

                    <div class="consumables-footer">
                        <p class="section-label">Consumíveis Recomendados</p>
                        <div class="items-row">
                            ${renderSlot(slots.pot1)}
                            ${renderSlot(slots.pot2)}
                            ${renderSlot(slots.pot3)}
                        </div>
                    </div>

                    <div class="build-description">
                        <p>${build.resumo}</p>
                    </div>
                </article>
                `;
                container.innerHTML += cardHtml;
            });
        }

        // 4. Executa a função pela primeira vez para carregar todas as builds
        renderizarBuilds(buildsDoBanco);

        // ==========================================
        // FUNÇÃO DE RENDERIZAÇÃO DO SLOT (Cores e Links)
        // ==========================================
        function renderSlot(item, extraClass = '') {
            const img = item.img_icon || '/static/img/items/empty.png';
            const name = item.nome_item || 'Vazio';
            const link = item.link_wiki || '';

            let cor = '';
            if (item.raridade) {
                cor = `style="border: 2px solid ${item.raridade}; box-shadow: inset 0 0 15px ${item.raridade}80;"`;
            }

            if (link) {
                return `
                <div class="item-slot ${extraClass}" data-name="${name}" ${cor}>
                    <a href="${link}" target="_blank">
                        <img src="${img}" alt="${name}">
                    </a>
                </div>
                `;
            } else {
                return `
                <div class="item-slot ${extraClass}" data-name="${name}" ${cor}>
                    <img src="${img}" alt="${name}">
                </div>
                `;
            }
        }
    });
</script>
{% endblock %}