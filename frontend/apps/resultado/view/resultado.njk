{% extends "templates/layout.njk" %}

{% block style %}
<link rel="stylesheet" href="/static/css/builds.css">
<link rel="stylesheet" href="/static/css/resultado.css">
{% endblock %}

{% block content %}
<main class="main-content">
    <header class="page-header">
        <h1 class="gold-title">Sua Party Otimizada</h1>
        <p class="subtitle">Com base nos itens encontrados no seu save, estas são as 4 melhores combinações para seu
            grupo.</p>
    </header>

    <div class="result-actions" style="margin-bottom: 30px; display: flex; gap: 15px; justify-content: center;">
        <button class="btn-secondary" onclick="window.location.href='/personalizar'">Novo Escaneamento</button>
        <button class="btn-primary" onclick="window.print()">Exportar PDF da Party</button>
    </div>

    <div class="builds-grid" id="builds-container">
        <div class="loading-msg" style="grid-column: 1/-1; text-align: center; color: gold;">
            <h2>🔮 Tecendo as tramas do destino...</h2>
        </div>
    </div>
</main>

<script>
    // Ponte entre o Banco de Dados (Backend via Nunjucks) e o JavaScript (Frontend)
    //  O Nunjucks substitui a tag abaixo pelo JSON real antes de enviar ao navegador.
    const buildsDoBanco = {{ data | dump | safe }};

    // Aguarda o HTML da página carregar completamente antes de executar o script
    document.addEventListener("DOMContentLoaded", () => {
        // Mapeia a div onde os cards das builds serão inseridos
        const container = document.getElementById('builds-container');
        // Puxa os dados do save extraído que foram guardados na memória do navegador
        const dadosSalvos = sessionStorage.getItem('saveDataBG3');

        // se o usuário acessou a página direto sem fazer upload,
        // redireciona ele de volta para a tela de extração (personalizar).
        if (!dadosSalvos) {
            window.location.href = "/personalizar";
            return;
        }

        // Converte a string salva no SessionStorage de volta para um array de objetos JavaScript
        const saveExtraido = JSON.parse(dadosSalvos);
        const buildsDoBanco = JSON.parse(stringDoBanco);
        // Achata a lista de itens: pega os itens de todos os personagens do save
        // e coloca em uma "piscina global" (inventarioJogador) apenas com os IDs.
        let inventarioJogador = [];
        for (let x = 0; x < saveExtraido.length; x++) {

            let personagem = saveExtraido[x];

            // Verifica se o personagem existe e se ele tem a propriedade Itens
            if (personagem !== null && personagem.Itens !== undefined) {

                for (let y = 0; y < personagem.Itens.length; y++) {

                    let item = personagem.Itens[y];

                    // Joga o ID do item na caixa gigante
                    inventarioJogador.push(item.TemplateID);
                }
            }
        }

        const dicionarioDeItens = {};
        buildsDoBanco.forEach(build => {
            build.lista_itens?.forEach(item => {
                // Usa o TemplateID como chave para guardar a informação do item completo
                dicionarioDeItens[item.TemplateID] = item;
            });
        });

        let atoMaximoDoJogador = 1; // Começa no Ato 1

        inventarioJogador.forEach(codigoItem => {
            const itemInfo = dicionarioDeItens[codigoItem];
            // Se achou o item no dicionário e o ato dele for maior que o atual, atualiza!
            if (itemInfo && itemInfo.ato_item > atoMaximoDoJogador) {
                atoMaximoDoJogador = itemInfo.ato_item;
            }
        });

        // Pega todas as builds e olha item por item(=>), mostra aquelas que cumprem o requisito(<=)
        let buildsDisponiveis = buildsDoBanco.filter(item => build.ato <= atoMaximoDoJogador);

        // Array que guardará as 4 builds finais vencedoras
        let partyIdeal = [];

        //Repete 4 vezes para formar um grupo (party) de 4 personagens
        for (let i = 0; i < 4; i++) {
            let melhorBuild = null;
            let maiorPontuacao = -1;
            let gastos = []; // Guarda temporariamente os itens que a build atual consumiria

            // Avalia todas as builds ainda disponíveis para encontrar a melhor da rodada
            buildsDisponiveis.forEach(build => {
                let pontos = 0;
                let encontrados = [];
                // Cria uma simulação do inventário para testar itens sem gastá-los de verdade ainda
                let simulacao = [...inventarioJogador];

                // Compara os itens exigidos pela build com o inventário simulado
                build.lista_itens?.forEach(itemReq => {
                    let idx = simulacao.indexOf(itemReq.TemplateID);

                    // Se o jogador possui o item exigido
                    if (idx !== -1) {
                        pontos++; // A build ganha 1 ponto
                        encontrados.push(itemReq.TemplateID); // Registra qual item foi achado
                        simulacao.splice(idx, 1); // Remove da simulação para não contar o mesmo item duas vezes
                    }
                });

                switch (build.ato) {
                    case 2:
                        pontos += 5;
                        break;
                    case 3:
                        pontos += 10;
                }

                // Se essa build fez mais pontos que a líder anterior, ela assume a liderança
                if (pontos > maiorPontuacao) {
                    maiorPontuacao = pontos;
                    melhorBuild = build;
                    gastos = encontrados;
                }
            });

            // Ao final da rodada, se encontrou uma build vencedora:
            if (melhorBuild) {
                partyIdeal.push(melhorBuild); // Adiciona na party final

                // Remove a build escolhida da lista de disponíveis para não repeti-la
                buildsDisponiveis = buildsDisponiveis.filter(b => b.id !== melhorBuild.id);

                // Consome DE FATO os itens usados pela build do inventário real do jogador,
                // garantindo que o próximo personagem não use o mesmo equipamento único.
                gastos.forEach(g => {
                    let idxReal = inventarioJogador.indexOf(g);
                    if (idxReal !== -1) inventarioJogador.splice(idxReal, 1);
                });
            }
        }

        // Limpa a mensagem de "carregando" do container
        container.innerHTML = '';

        // Percorre as 4 builds escolhidas para desenhá-las na tela
        partyIdeal.forEach(build => {

            // Dicionário para organizar os itens recebidos do banco nos seus slots corretos do corpo
            const slots = {
                head: {}, cloak: {}, chest: {}, gloves: {}, boots: {}, amulet: {},
                ring1: {}, ring2: {}, melee_main: {}, melee_off: {},
                ranged_main: {}, ranged_off: {}, pot1: {}, pot2: {}, pot3: {}
            };

            // Preenche o dicionário de slots se a build pedir um item para aquele local
            build.lista_itens?.forEach(item => {
                if (slots[item.slot]) {

                    slots[item.slot] = item;

                }
            });


            // Monta a estrutura HTML do Card (Template Literal) interpolando as variáveis do objeto
            const cardHtml = `
            <article class="build-card extended">
                <div class="card-header-main">
                    <h3 class="gold-text">${build.nome}</h3>
                    <div class="recommendation-badge">Ato ${build.ato} Recomendado</div>
                    <span class="class-tag">${build.classes}</span>
                </div>

                <div class="build-grid-container">
                    <div class="stats-side">
                        <div class="stats-list">
                            <div class="stat-item"><span>STR</span> <strong>${build.str}</strong></div>
                            <div class="stat-item"><span>DEX</span> <strong>${build.dex}</strong></div>
                            <div class="stat-item"><span>CON</span> <strong>${build.con}</strong></div>
                            <div class="stat-item"><span>INT</span> <strong>${build.int_stat}</strong></div>
                            <div class="stat-item"><span>WIS</span> <strong>${build.wis}</strong></div>
                            <div class="stat-item"><span>CHA</span> <strong>${build.cha}</strong></div>
                        </div>
                        <div class="ac-display">
                            <span class="ac-label">AC</span>
                            <span class="ac-value">${build.ac}</span>
                        </div>
                    </div>

                    <div class="center-preview">
                        <div class="image-frame">
                            <img src="${build.img_portrait}" alt="${build.nome}">
                        </div>
                    </div>

                    <div class="gear-side">
                        ${renderSlot(slots.head)}
                        ${renderSlot(slots.cloak)}
                        ${renderSlot(slots.chest)}
                        ${renderSlot(slots.amulet)}
                        ${renderSlot(slots.gloves)}
                        ${renderSlot(slots.ring1)}
                        ${renderSlot(slots.boots)}
                        ${renderSlot(slots.ring2)}
                    </div>
                </div>

                <div class="weapons-section">
                    <div class="weapon-group">
                        <span class="label">Melee</span>
                        <div class="slot-row">
                            ${renderSlot(slots.melee_main, 'weapon-size')}
                            ${renderSlot(slots.melee_off, 'weapon-size')}
                        </div>
                    </div>
                    <div class="weapon-group">
                        <span class="label">Ranged</span>
                        <div class="slot-row">
                            ${renderSlot(slots.ranged_main, 'weapon-size')}
                            ${renderSlot(slots.ranged_off, 'weapon-size')}
                        </div>
                    </div>
                </div>

                <div class="consumables-footer">
                    <p class="section-label">Consumíveis Recomendados</p>
                    <div class="items-row">
                        ${renderSlot(slots.pot1)}
                        ${renderSlot(slots.pot2)}
                        ${renderSlot(slots.pot3)}
                    </div>
                </div>

                <div class="build-description">
                    <p>${build.resumo}</p>
                </div>
            </article>
        `;
            // Injeta o HTML gerado dentro do container na página
            container.innerHTML += cardHtml;
        });


        /**
         * Função que gera o HTML de um único espaço (slot) de equipamento.
         * Trata a ausência de itens aplicando uma imagem vazia padrão.
         * * @param {Object} item - Objeto do item contendo imagem, nome e link.
         * @returns {String} HTML em formato de texto para ser injetado.
         */
        function renderSlot(item, extraClass = '') {
            const img = item.img_icon || '/static/img/items/empty.png';
            const name = item.nome_item || 'Vazio';
            const link = item.link_wiki || '';

            cor = `style="border: 2px solid ${item.raridade}; box-shadow: inset 0 0 15px ${item.raridade}80;"`;

            return `
            <div class="item-slot" data-name="${name}" ${cor}>
                <a href="${link}">
                    <img src="${img}" alt="${name}">
                </a>
            </div>
        `;
        }
    });
</script>
{% endblock %}